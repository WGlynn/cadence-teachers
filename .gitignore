# Allow-list: everything is private unless listed below (internal ops notes stay out of the public repo).
/*
!/.gitignore
!/README.md
!/CONTRIBUTING.md
!/LICENSE
!/LICENSE-docs.md
!/CONTRIBUTING.md
!/requirements.txt
!/setup.sh
!/VS-TRANSFER-PROGRAM.md
!/EXPERIMENT-QUEUE.md
!/EXPERIMENT-RESULTS.md
!/M5-EXOGENOUS-ANCHOR.md
!/experiments/
!/exp/
!/ui/
!/.github/
!/site/
# inside exp: no brain checkpoints, caches, scratch backups
/exp/*_brains/
/exp/__pycache__/
/exp/smoke/
/exp/*.bak
/exp/*.npz
__pycache__/
# web app: no dependencies, build output, or the synced data copy (experiments/atlas.json is the source)
/site/node_modules/
/site/dist/
/site/src/data/atlas.json
